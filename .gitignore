# ComChat - Git Ignore File

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js dependencies (if we add them later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
out/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Temporary folders
tmp/
temp/

# Coverage directory used by tools like istanbul
coverage/

# Browser cache
.cache/

# MacOS
*.dmg

# Windows
*.exe
*.msi

# Backup files
*.backup
*.bak
*.orig

# Test files (optional)
test-results/
screenshots/

# Database files (for future use)
*.db
*.sqlite
*.sqlite3

# Private keys and certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Temporary files created during development
.tmp/
.temp/
# Claude Code local dev config
.claude/
